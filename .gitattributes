# Normalize all text files to LF in the repo, regardless of a machine's core.autocrlf setting.
# This stops files from flipping between LF/CRLF (and showing up as "modified" with no real
# content change) when switching between PCIX, Omen and the laptop.
* text=auto eol=lf

# Unity YAML-serialized assets
*.meta               text eol=lf
*.asset              text eol=lf
*.prefab             text eol=lf
*.unity              text eol=lf
*.mat                text eol=lf
*.controller         text eol=lf
*.overrideController text eol=lf
*.anim               text eol=lf
*.playable           text eol=lf
*.mixer              text eol=lf
*.physicMaterial     text eol=lf
*.physicsMaterial2D  text eol=lf
*.renderTexture      text eol=lf
*.lighting           text eol=lf
*.shadergraph        text eol=lf
*.shadersubgraph     text eol=lf
*.preset             text eol=lf
*.asmdef             text eol=lf
*.inputactions       text eol=lf

# Code / shaders / plain text
*.cs                 text eol=lf diff=csharp
*.shader             text eol=lf
*.cginc              text eol=lf
*.hlsl               text eol=lf
*.json               text eol=lf
*.xml                text eol=lf
*.txt                text eol=lf
*.md                 text eol=lf

# Binary assets — never touch line endings, never diff as text
*.png    binary
*.tga    binary
*.tif    binary
*.exr    binary
*.psd    binary
*.fbx    binary
*.wav    binary
*.mp3    binary
*.webm   binary
*.ttf    binary
*.pdf    binary
*.wlt    binary

# Collapse noisy Unity-generated files in GitHub's diff view
*.meta   linguist-generated
*.asset  linguist-generated
*.prefab linguist-generated
*.unity  linguist-generated
